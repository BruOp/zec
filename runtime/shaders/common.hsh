static const float TWO_PI = 6.283185307179586;
static const float HALF_PI = 1.5707963267948966;
static const float PI = 3.141592653589793;
static const float INV_PI = 0.318309886;
#define FLT_EPSILON 1.1920928955078125e-07F

static const uint INVALID_TEXTURE_IDX = (1u << 24u) - 1u;
static const float BLUE_NOISE_TEXTURE_SIZE = 128;

float3 float3_splat(float x)
{
    return float3(x, x, x);
}

float clamp_dot(float3 A, float3 B)
{
    return saturate(dot(A, B));
}

float3 remap(float3 val, float3 min_old, float3 max_old, float3 min_new, float3 max_new)
{
    float3 normalized = (val - min_old) / (max_old - min_old);
    return (normalized * (max_new - min_new)) + min_new;

}

bool is_texture_id_valid(uint idx)
{
    return idx != INVALID_TEXTURE_IDX;
}